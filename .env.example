# Sanitized environment example for cm-outbound-bench.
#
# This file contains placeholders only. Never commit a real credential.
# The application does NOT load this file automatically: copy it to .env and
# source it (set -a; . ./.env; set +a) or export the variables yourself.

# Credential consumed by the provider profile. `providers.toml` names the
# environment variable through `api_key_env`; the shipped example uses
# DEEPSEEK_API_KEY. The key never goes into providers.toml itself.
DEEPSEEK_API_KEY=

# Group A decision-point baseline. `configs/baseline_agent.toml` names
# DEEPSEEK_API_KEY as `api_key_env`; these overrides are optional.
# CM_BASELINE_API_BASE=https://api.deepseek.com/v1
# CM_BASELINE_API_KEY=
# CM_BASELINE_MODEL=deepseek-flash
# CM_BASELINE_TIMEOUT=60
# CM_BASELINE_MAX_RETRIES=2
# CM_BASELINE_TEMPERATURE=0.2
# CM_BASELINE_MAX_OUTPUT_TOKENS=900
# CM_BASELINE_HEADER_ENVS={"X-Example-Header": "EXAMPLE_HEADER_VALUE"}
# CM_BASELINE_AGENT_CONFIG=configs/baseline_agent.toml

# Optional decision-pipeline config overrides.
# CM_DECISION_DATASET_CONFIG=configs/dataset.toml
# CM_DECISION_SPLIT_CONFIG=configs/split.toml

# Milestone 1.2: DeepSeek V4 Pro Ground Truth Generator / Evaluation Judge.
# `configs/decision_annotation.toml` names DEEPSEEK_API_KEY; these overrides are
# optional. The model must be the verified identifier `deepseek-v4-pro`; any
# other value is refused without substitution.
# CM_JUDGE_CONFIG=configs/decision_annotation.toml
# CM_JUDGE_API_BASE=https://api.deepseek.com/v1
# CM_JUDGE_MODEL=deepseek-v4-pro
# CM_JUDGE_TIMEOUT=120
# CM_JUDGE_MAX_RETRIES=3
# CM_JUDGE_TEMPERATURE=0.0
# CM_JUDGE_MAX_OUTPUT_TOKENS=6000
# CM_JUDGE_HEADER_ENVS={"X-Example-Header": "EXAMPLE_HEADER_VALUE"}
# CM_JUDGE_ANNOTATION_PROMPT_VERSION=v1
# CM_JUDGE_EVALUATION_PROMPT_VERSION=v1

# Optional overrides. Defaults apply when unset; uncomment to change them.
# CM_OUTBOUND_PROVIDER_CONFIG=providers.toml
# CM_OUTBOUND_RUN_DIR=outputs/runs
# CM_OUTBOUND_DATA_ROOT=../data
# CM_OUTBOUND_CORPUS_DIR=../data/deidentified/cm_outbound_v2
# CM_OUTBOUND_CORPUS_DB=../data/corpus_db/cm_outbound_corpus.sqlite
