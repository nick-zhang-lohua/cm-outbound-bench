            "message": "行，我的测试身份令牌是 TEST_IDENTITY_C102。",
            "intent": "provide_identity"
          },
          {
            "step_id": "ask_fee",
            "trigger": "always",
            "missing_terms": [
              "monthly_fee"
            ],
            "message": "每个月多收多少钱？"
          },
          {
            "step_id": "ask_validity",
            "trigger": "always",
            "missing_terms": [
