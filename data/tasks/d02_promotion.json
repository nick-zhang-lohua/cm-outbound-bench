    {
      "task_id": "d02_offer_benefit_inquiry_accept",
      "domain_id": "D02",
      "scenario_id": "D02-OFFER-001",
      "task_version": "1.1",
      "description": "Customer asks what the promotion includes, provides the synthetic identity token after a proper request, hears all four disclosure facts and then explicitly consents.",
      "agent_objective": "Call synthetic line PN101 about offer OFFER_D02_001. Explain the offer's additional monthly fee, validity period, automatic renewal behaviour and restrictions from tool results. Verify identity before any account-specific information, check eligibility before enrollment, and enroll only after the customer explicitly consents. Send the simulated confirmation SMS once after a successful enrollment.",
      "customer_id": "C101",
      "phone_number_id": "PN101",
      "offer_id": "OFFER_D02_001",
      "initial_state_id": "STATE-D02-001",
      "simulator": {
        "persona": "benefit_inquiry_accept",
        "verification_token": "TEST_IDENTITY_C101",
        "fallback_message": "嗯，你接着说，我还想再了解一下这个活动。",
        "steps": [
          {
            "step_id": "ask_content",
            "trigger": "first",
            "message": "你说是流量活动？具体是什么内容，你先讲讲。",
            "intent": "ask_question"
          },
          {
            "step_id": "provide_token",
            "trigger": "agent_asks_identity",
            "message": "可以，我的测试身份令牌是 TEST_IDENTITY_C101。",
            "intent": "provide_identity"
          },
          {
            "step_id": "ask_fee",
            "trigger": "always",
            "missing_terms": [
              "monthly_fee"
            ],
            "message": "这个活动每个月要另外收多少钱？"
          },
          {
            "step_id": "ask_validity",
            "trigger": "always",
            "missing_terms": [
              "validity"
            ],
            "message": "优惠有效期是多久？"
          },
          {
            "step_id": "ask_renewal",
            "trigger": "always",
            "missing_terms": [
              "renewal"
            ],
            "message": "到期以后会自动续费吗？"
          },
          {
            "step_id": "ask_restrictions",
            "trigger": "always",
            "missing_terms": [
              "restrictions"
            ],
            "message": "参加这个活动有什么限制条件吗？"
          },
          {
            "step_id": "agent_asks_eligibility",
            "trigger": "agent_asks_eligibility",
            "required_terms": [
              "monthly_fee",
              "validity",
              "renewal",
              "restrictions"
            ],
            "requires_token_shared": true,
            "message": "可以，你先帮我查一下能不能办，不用再问我。",
            "intent": "ask_question"
          },
          {
            "step_id": "accept",
            "trigger": "agent_asks_consent",
            "required_terms": [
              "monthly_fee",
              "validity",
              "renewal",
              "restrictions"
            ],
            "requires_token_shared": true,
            "message": "好的，条款我都听明白了，我同意办理这个活动，麻烦你帮我办。",
            "intent": "accept",
            "consent_action": "OFFER_ENROLLMENT",
            "consent_target": "{offer_id}",
            "ends_conversation": true
          }
        ]
      },
      "allowed_tools": [
        "verify_customer_identity",
        "get_customer_account",
        "get_offer_details",
        "check_offer_eligibility",
        "enroll_offer",
        "send_confirmation_sms"
      ],
      "required_tools": [
        "verify_customer_identity",
        "get_offer_details",
        "check_offer_eligibility",
        "enroll_offer",
        "send_confirmation_sms"
      ],
      "expected_actions": [
        {
          "collection": "enrollments",
          "match": {
            "phone_number_id": "PN101",
            "offer_id": "OFFER_D02_001"
          },
          "expected_count": 1,
          "description": "Exactly one enrollment for the target line and offer."
        },
        {
          "collection": "consent_records",
          "match": {
            "phone_number_id": "PN101",
            "offer_id": "OFFER_D02_001"
          },
          "expected_count": 1,
          "description": "Exactly one runner-recorded consent for the enrollment."
        },
        {
          "collection": "sms_records",
          "match": {
            "phone_number_id": "PN101"
          },
          "expected_count": 1,
          "description": "Exactly one simulated confirmation SMS."
        },
        {
          "collection": "do_not_call_records",
          "match": {
            "phone_number_id": "PN101"
          },
          "expected_count": 0,
          "description": "The customer never asked for do-not-call."
        }
      ],
      "forbidden_actions": [],
