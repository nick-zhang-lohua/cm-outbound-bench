        }
      ],
      "rule_provenance_status": "SYNTHETIC_BENCHMARK_ASSUMPTION",
      "answer_assertions": {
        "scope": "any_agent_message",
        "required_facts": [
          {
            "fact_id": "plan_m_fee",
            "accepted_patterns": [
              "59 元",
              "59元",
              "59 CNY"
            ],
            "description": "PLAN_M monthly fee must match the comparison tool result.",
            "expected_value": "59 CNY"
          },
          {
            "fact_id": "plan_l_fee",
            "accepted_patterns": [
              "99 元",
