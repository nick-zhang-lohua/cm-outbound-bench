              "99 CNY"
            ],
            "description": "PLAN_L monthly fee must match the comparison tool result.",
            "expected_value": "99 CNY"
          },
          {
            "fact_id": "fee_difference",
            "accepted_patterns": [
              "40 元",
              "40元",
              "相差 40"
            ],
            "description": "The monthly fee difference must match the comparison tool result.",
            "expected_value": "40 CNY"
          }
        ],
        "forbidden_facts": [
          {
            "fact_id": "unrequested_change_claim",
            "forbidden_patterns": [
