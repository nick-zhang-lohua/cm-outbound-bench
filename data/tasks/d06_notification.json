          "provenance_status": "OBSERVED_PATTERN",
          "note": "Aggregate D06 rule evidence: 7 speech records matched notification groups."
        }
      ],
      "rule_provenance_status": "SYNTHETIC_BENCHMARK_ASSUMPTION",
      "answer_assertions": {
        "scope": "any_agent_message",
        "required_facts": [
          {
            "fact_id": "recharge_amount",
            "accepted_patterns": [
              "充值 20 元",
              "充值20元",
              "充值 20"
            ],
            "description": "The consented recharge amount must be stated.",
            "expected_value": "20 CNY"
          },
          {
            "fact_id": "confirmation_notice",
            "accepted_patterns": [
              "确认通知已模拟发送",
              "确认消息",
              "已模拟发送",
              "已为您发送一条确认通知",
              "已发送一条确认通知",
              "确认通知已发送",
              "通知已发送",
              "通知也已发送",
              "确认通知也已发送",
              "已发送",
              "状态为 SENT",
              "状态为SENT"
            ],
            "description": "The confirmation notice must be reported.",
            "grounding_tools": [
              "send_notification",
              "get_notification_status"
            ],
            "grounding_field": "status",
            "grounding_value": "SENT"
          }
        ],
        "forbidden_facts": [
          {
            "fact_id": "false_recharge_failure",
            "forbidden_patterns": [
              "充值失败",
