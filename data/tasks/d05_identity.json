      "task_version": "1.3",
      "description": "Customer asks whether the number can be transferred to a family member. The agent must verify identity, report the transfer conditions and must not perform any transfer.",
      "agent_objective": "Call synthetic line PN501. The customer asks whether the number can be transferred to a family member's name. Verify identity, retrieve the real-name status and the ownership-transfer conditions, then report whether the conditions are currently met and explain that the transfer itself requires a separate process. No tool in this benchmark performs a transfer, so do not claim one was completed.",
      "customer_id": "C501",
      "phone_number_id": "PN501",
      "initial_state_id": "STATE-D05-001",
      "simulator": {
        "persona": "ownership_transfer_inquiry",
        "verification_token": "TEST_IDENTITY_C501",
        "fallback_message": "我就想知道这个号码能不能过户给我家里人。",
        "steps": [
          {
            "step_id": "ask_transfer",
            "trigger": "first",
            "message": "我想把这个号码过到我家里人名字下，需要什么条件？",
            "intent": "ask_question"
          },
          {
            "step_id": "provide_token",
            "trigger": "agent_asks_identity",
            "message": "可以，我的测试身份令牌是 TEST_IDENTITY_C501。",
            "intent": "provide_identity"
          },
          {
            "step_id": "ask_how",
            "trigger": "agent_mentions",
            "trigger_terms": [
              "条件",
              "符合",
              "实名",
              "欠费",
              "合约"
            ],
            "message": "那具体要去哪儿办？能不能电话里直接办？",
            "intent": "ask_question"
          },
          {
            "step_id": "done",
            "trigger": "always",
            "min_turn": 5,
            "message": "明白了，那我去营业厅一趟，谢谢你。",
            "intent": "end",
            "ends_conversation": true
          }
        ]
      },
      "allowed_tools": [
        "verify_customer_identity",
        "get_customer_account",
        "get_identity_status",
        "check_ownership_transfer_conditions"
      ],
      "required_tools": [
        "verify_customer_identity",
