  "tasks": [
    {
      "task_id": "d04_plan_upgrade_with_consent",
      "domain_id": "D04",
      "scenario_id": "D04-LIFECYCLE-001",
      "task_version": "1.1",
      "description": "Customer asks to upgrade from PLAN_M to PLAN_L. The agent must check eligibility, obtain consent naming PLAN_L, then submit exactly one plan change.",
      "agent_objective": "Call synthetic line PN401. The customer wants to move to PLAN_L, the highest-tier plan. Verify identity, retrieve the subscription status, check plan-change eligibility for PLAN_L, explain the blocking reasons if any, and submit the change only after the customer explicitly consents to PLAN_L.",
      "customer_id": "C401",
      "phone_number_id": "PN401",
      "initial_state_id": "STATE-D04-001",
      "simulator": {
        "persona": "plan_upgrade_request",
        "verification_token": "TEST_IDENTITY_C401",
        "fallback_message": "我想确认一下我这个号码能不能升级到高档套餐。",
        "steps": [
          {
            "step_id": "ask_upgrade",
            "trigger": "first",
            "message": "我想把套餐升级到你们最高档的那个，能办吗？",
            "intent": "ask_question"
          },
          {
            "step_id": "provide_token",
            "trigger": "agent_asks_identity",
            "message": "可以，我的测试身份令牌是 TEST_IDENTITY_C401。",
            "intent": "provide_identity"
          },
          {
            "step_id": "ask_effect",
            "trigger": "agent_mentions",
            "trigger_terms": [
              "符合",
              "可以办理",
              "升级",
              "费用"
            ],
            "message": "那什么时候生效？会多收多少钱？",
            "intent": "ask_question"
          },
          {
            "step_id": "consent_upgrade",
            "trigger": "agent_asks_consent",
            "message": "好，我同意升级到尊享套餐 PLAN_L，麻烦你办理。",
            "intent": "accept",
            "consent_action": "PLAN_CHANGE",
            "consent_target": "PLAN_L",
            "ends_conversation": true
          }
        ]
      },
      "allowed_tools": [
        "verify_customer_identity",
        "get_customer_account",
        "get_subscription_status",
        "check_plan_change_eligibility",
        "submit_plan_change",
        "list_plans",
        "get_plan_details"
      ],
      "required_tools": [
        "verify_customer_identity",
        "check_plan_change_eligibility",
        "submit_plan_change"
      ],
      "expected_actions": [
        {
          "collection": "plan_change_requests",
          "match": {
            "phone_number_id": "PN401",
            "to_plan_id": "PLAN_L",
            "status": "APPROVED"
          },
          "expected_count": 1,
          "description": "Exactly one approved change to PLAN_L."
        },
        {
          "collection": "action_consents",
          "match": {
            "phone_number_id": "PN401",
            "action": "PLAN_CHANGE",
            "target_ref": "PLAN_L"
          },
          "expected_count": 1,
          "description": "Exactly one consent naming PLAN_L."
        }
      ],
      "forbidden_actions": [],
      "success_criteria": {
        "max_turns": 28,
        "max_tool_calls": 16,
        "require_finish": true
      },
