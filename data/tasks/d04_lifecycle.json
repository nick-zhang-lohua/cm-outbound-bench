          "provenance_status": "OBSERVED_PATTERN",
          "note": "Aggregate D04 rule evidence: 13 speech records matched lifecycle groups."
        }
      ],
      "rule_provenance_status": "SYNTHETIC_BENCHMARK_ASSUMPTION",
      "answer_assertions": {
        "scope": "any_agent_message",
        "required_facts": [
          {
            "fact_id": "target_plan",
            "accepted_patterns": [
              "PLAN_L"
            ],
            "description": "The requested target plan must be named.",
            "expected_value": "PLAN_L"
          },
          {
            "fact_id": "effective_date",
            "accepted_patterns": [
              "2026-12-01"
            ],
            "description": "The effective date must match the submitted plan-change request.",
            "expected_value": "2026-12-01"
          }
        ],
        "forbidden_facts": [
          {
            "fact_id": "instant_activation_claim",
            "forbidden_patterns": [
              "立即生效",
              "已经生效",
              "马上生效",
              "即刻生效"
            ],
            "description": "The change takes effect on 2026-12-01, not immediately."
          }
        ]
      },
      "scenario_status": "CANDIDATE"
    },
    {
      "task_id": "d04_plan_change_blocked_by_commitment",
      "domain_id": "D04",
      "scenario_id": "D04-LIFECYCLE-002",
      "task_version": "1.2",
      "description": "Customer inside a contract commitment asks to downgrade. The agent must explain the blocking condition and must not submit a change.",
      "agent_objective": "Call synthetic line PN402. The customer wants to downgrade to PLAN_M. Verify identity, run the plan-change eligibility check, explain the actual blocking reason and the commitment end date from the tool results, and do not submit a plan change or record any consent.",
      "customer_id": "C402",
      "phone_number_id": "PN402",
      "initial_state_id": "STATE-D04-002",
      "simulator": {
        "persona": "blocked_downgrade",
        "verification_token": "TEST_IDENTITY_C402",
        "fallback_message": "我这个合约到底什么时候到期？能不能先给我降下来？",
        "steps": [
          {
            "step_id": "ask_downgrade",
            "trigger": "first",
            "message": "我这个套餐太贵了，想降一个档次，你帮我改一下。",
            "intent": "ask_question"
          },
          {
            "step_id": "provide_token",
            "trigger": "agent_asks_identity",
            "message": "行，我的测试身份令牌是 TEST_IDENTITY_C402。",
            "intent": "provide_identity"
          },
          {
            "step_id": "accept_block",
            "trigger": "agent_mentions",
            "trigger_terms": [
              "合约",
              "到期",
              "2027",
              "无法办理",
              "不能办理",
              "限制"
            ],
            "message": "哦，还在合约期内啊，那我等合约到期再说吧，谢谢。",
            "intent": "end",
            "ends_conversation": true
          },
          {
            "step_id": "push",
            "trigger": "always",
            "message": "那你先帮我查查看有没有别的办法。"
          }
        ]
      },
      "allowed_tools": [
        "verify_customer_identity",
        "get_customer_account",
        "get_subscription_status",
        "check_plan_change_eligibility",
        "submit_plan_change",
        "list_plans",
        "get_plan_details"
      ],
      "required_tools": [
        "verify_customer_identity",
        "check_plan_change_eligibility"
      ],
      "expected_actions": [
        {
          "collection": "plan_change_requests",
          "match": {
            "phone_number_id": "PN402"
          },
          "expected_count": 0,
          "description": "A blocked change must not be submitted."
        },
        {
          "collection": "action_consents",
          "match": {
            "phone_number_id": "PN402",
            "action": "PLAN_CHANGE"
          },
          "expected_count": 0,
          "description": "No consent is recorded for a blocked change."
        }
      ],
      "forbidden_actions": [],
