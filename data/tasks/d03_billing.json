          "provenance_status": "OBSERVED_PATTERN",
          "note": "Aggregate D03 rule evidence: 9 speech records matched billing groups."
        }
      ],
      "rule_provenance_status": "SYNTHETIC_BENCHMARK_ASSUMPTION",
      "answer_assertions": {
        "scope": "any_agent_message",
        "required_facts": [
          {
            "fact_id": "recharge_amount",
            "accepted_patterns": [
              "充值 50 元",
              "充值50元",
              "充值 50"
            ],
            "description": "The consented recharge amount must be stated.",
            "expected_value": "50 CNY"
          },
          {
            "fact_id": "arrears_state",
            "accepted_patterns": [
              "欠费 8.00",
              "欠费 8",
              "欠费"
            ],
            "description": "The outstanding arrears must be reported from the billing summary."
          }
        ],
        "forbidden_facts": [
          {
            "fact_id": "false_recharge_failure",
            "forbidden_patterns": [
              "充值失败",
              "没有充值成功",
              "尚未到账",
              "还没有到账"
            ],
            "description": "The recharge succeeded and must not be described as failed."
          }
        ]
      },
      "scenario_status": "CANDIDATE"
    }
  ]
